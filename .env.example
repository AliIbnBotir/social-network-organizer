# Copy this file to .env and fill in your values. Never commit .env.

# Telegram bot token from @BotFather. The bot must be an admin of your channel
# with permission to post messages.
TELEGRAM_BOT_TOKEN=

# Your channel: either @channel_username or the numeric id (e.g. -1001234567890).
TELEGRAM_CHANNEL_ID=

# Database. SQLite by default; switch to PostgreSQL later with e.g.
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/organizer
DATABASE_URL=sqlite+aiosqlite:///./data/organizer.db

# Where uploaded images and videos are stored.
MEDIA_DIR=./data/media

# Timezone used for scheduling (IANA name).
TIMEZONE=Asia/Tashkent

# How often (seconds) the scheduler checks for posts that are due.
SCHEDULER_POLL_SECONDS=30
